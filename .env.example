# Copiar a .env para desarrollo local. NUNCA subir .env al repositorio.
# Todos los valores son de ejemplo (demo sin cobros reales).
NODE_ENV=development
PORT=3000

# Conexión local (fuera de Docker). Dentro de Docker se usa el host "db".
DATABASE_URL=postgresql://tosabus:tosabus@localhost:5432/tosabus
POSTGRES_DB=tosabus
POSTGRES_USER=tosabus
POSTGRES_PASSWORD=tosabus
POSTGRES_PORT=5432

# Orígenes permitidos por CORS (separados por comas; "*" solo para desarrollo).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Valor de ejemplo: reemplazar por un secreto largo y propio en producción.
JWT_SECRET=cambie-este-valor-por-un-secreto-largo-en-produccion-123456
